// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // "native" cubre el host (glibc). El target musl-openssl-3.0.x es necesario
  // para el contenedor (node:20-alpine): sin el, Prisma no detecta la version
  // de OpenSSL, cae a openssl-1.1.x y falla con
  // "Error loading shared library libssl.so.1.1".
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- NextAuth required tables ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Application models ---

// GlobalRole values: ADMIN | TECNICO | VIEWER
// (stored as String for SQLite compatibility — validated at application layer)
model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String?
  role     String  @default("VIEWER") // GlobalRole: ADMIN | TECNICO | VIEWER

  accounts       Account[]
  sessions       Session[]
  employee       Employee?
}

model Employee {
  id              String  @id @default(cuid())
  name            String
  userId          String  @unique
  rotationOrder   Int
  shiftPreference String? // "M" | "T" | null — preferencia de turno (puede ignorarse si hay restricciones)
  active          Boolean @default(true) // soft-delete: false = desactivado (datos e historial conservados)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftAssignments ShiftAssignment[]
  changeLogs       ShiftChangeLog[]
}

// ShiftType values: M | T | N | J | D | V | B | MF | TF | NF
model ShiftAssignment {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime
  shiftType  String
  manual     Boolean  @default(false) // true = assigned manually by admin (not auto-generated)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model Schedule {
  id          Int       @id @default(autoincrement())
  month       Int
  year        Int
  published   Boolean   @default(false)
  publishedAt DateTime?
  publishedBy String?
  generatedAt DateTime  @default(now())

  @@unique([year, month])
}

// Días festivos (nacionales)
model Holiday {
  id          String   @id @default(cuid())
  date        DateTime // UTC midnight del día festivo
  description String
  year        Int      // año duplicado para filtrar fácilmente

  @@unique([date])
}

// Registro de cambios manuales de turno
model ShiftChangeLog {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime // fecha del turno modificado
  oldShift   String?  // null si es una asignación nueva
  newShift   String
  changedBy  String   // email del usuario que hizo el cambio
  changedAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// Snapshot del cuadrante antes de una generación — permite un nivel de deshacer
model ScheduleSnapshot {
  id        String   @id @default(cuid())
  month     Int
  year      Int
  snapshot  String   // JSON: [{ employeeId, date, shiftType }]
  createdAt DateTime @default(now())

  @@unique([year, month])
}