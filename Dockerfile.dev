FROM node:20-alpine

# openssl: requerido por el query engine de Prisma. Sin el, Prisma no puede
# detectar la version de OpenSSL y falla al cargar libquery_engine.
RUN apk add --no-cache openssl

WORKDIR /app

COPY package*.json ./
RUN npm ci --prefer-offline --no-audit 2>/dev/null || npm install

COPY . .

RUN npx prisma generate

EXPOSE 3000

CMD ["npm", "run", "dev"]